# Copia a .env y sustituye USER/PASSWORD solo allí; nunca pongas credenciales reales en ejemplos.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/nexodesk?schema=public"

# Orígenes exactos separados por comas. En producción usa los dominios reales de la app.
CORS_ORIGINS="http://localhost:5173"

# Usa `none` solo si frontend y API están en sitios distintos y ambos usan HTTPS.
AUTH_COOKIE_SAME_SITE="lax"
